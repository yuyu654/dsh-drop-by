{
  "name": "@joshin/dsh-drop-by",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "让你的 DS 主动来找你，也有自己的新鲜事想分享。 dsh-drop-by「陪伴」沿用你设定的人设，结合最近聊天、记忆与作息，挑合适的时机开口，也给忙碌的你留出安静。ta可以自己查资料、看网页和视频，在研究与休闲之间切换，把新发现、探索进展和当时的心情带回来。QQ、抖音私信任选主入口，共用 DSH 会话；手机上一句“帮我查查这个”，就能发起搜索、推进探索或整理探索笔记，完成后直接收到结果。支持连发消息合并、热聊自然补话、会话前情衔接，还可搭配「鱼鱼状态」感知你的作息。主动频率、免打扰时段和探索节奏，都由你决定。",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "presence",
    "proactive"
  ],
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./engine": "./src/engine.js",
    "./video": "./src/video-host.js",
    "./qq-reply": "./src/qq-reply.js",
    "./run": "./src/run.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "tools",
    "cordis.patch.yml",
    "headless-overlay.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "config.example.json",
    "local-style.example.json"
  ],
  "scripts": {
    "once": "node src/run.js --once",
    "status": "node src/run.js --status",
    "windows": "node src/run.js --windows",
    "loop": "node src/run.js --loop",
    "mail": "node src/run.js --mail",
    "mail-now": "node src/run.js --mail-now",
    "test": "node --test tests/*.test.mjs",
    "compose": "node src/run.js --compose",
    "compose-llm": "node src/run.js --compose --llm",
    "why": "node src/run.js --why",
    "persona": "node src/run.js --persona"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
   "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyu654/dsh-drop-by.git"
  }
}
