{
  "name": "@joshin/dsh-drop-by",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "description": "主动陪伴插件：沿用你的人设，挑合适时机主动来聊；有独立作息、会自己搜网页看视频，也能识别收尾信号不硬聊。新装默认 DSH 内部会话开箱即用，可随时切到 QQ 或抖音私信并共用同一会话，支持私聊派任务与约定提醒。QQ/抖音入口需分别配合 dsh-plugin-qq-bridge / dsh-douyin-scroll。",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "presence",
    "proactive",
    "ai-companion",
    "qq",
    "douyin"
  ],
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./engine": "./src/decision/engine.js",
    "./video": "./src/perception/video-host.js",
    "./qq-reply": "./src/chat/qq-reply.js",
    "./run": "./src/run.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./src/client.js"
  },
  "files": [
    "src",
    "tools",
    "docs",
    "cordis.patch.yml",
    "headless-overlay.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "config.example.json",
    "local-style.example.json"
  ],
  "scripts": {
    "once": "node src/run.js --once",
    "status": "node src/run.js --status",
    "windows": "node src/run.js --windows",
    "loop": "node src/run.js --loop",
    "mail": "node src/run.js --mail",
    "mail-now": "node src/run.js --mail-now",
    "test": "node --test tests/*.test.mjs",
    "build:client": "node tools/build-client.mjs",
    "compose": "node src/run.js --compose",
    "compose-llm": "node src/run.js --compose --llm",
    "why": "node src/run.js --why",
    "persona": "node src/run.js --persona"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
   "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyu654/dsh-drop-by.git"
  }
}
